# Anthropic Claude API Key (required for AI chat)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ZocDoc API Key (optional — uses sample data if not set)
ZOCDOC_API_KEY=your-zocdoc-api-key-here

# CMS Marketplace API key for the coverage-transition feature (optional).
# Without it, the feature still works but shows no live HealthCare.gov plan list.
# Request one at https://developer.cms.gov/marketplace-api/key-request.html
CMS_MARKETPLACE_API_KEY=
# auto (default: live if key set) | live | fixture (sample data for local dev) | off
CMS_MARKETPLACE_MODE=auto
